# Pooled Neon connection string; set this as a Cloudflare Pages secret.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/estatein?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@yourdomain.com

# One SchoolsAI workspace for both advisor scopes. Keep the key server-side.
SCHOOLSAI_SYSTEM_API_KEY=
# Shared secret used only by SchoolsAI when it calls the private listing tools.
SCHOOLSAI_TOOL_SECRET=

# Bearer token required by the MCP server at /mcp (read-only listing tools). The endpoint is disabled while blank.
MCP_API_KEY=

# Daily property matching. Use a long random value for CRON_SECRET.
CRON_SECRET=
PUBLIC_SITE_URL=https://your-domain.example

# JSON array of approved external JSON feeds. Each feed returns an array or {"items": [...]}.
# Item fields: id, url, title, description, propertyType, price, currency,
# bedrooms, bathrooms, areaSqm, address, city, region, imageUrl, publishedAt.
EXTERNAL_PROPERTY_FEEDS=[]

# Optional email delivery. Matches are still stored when these are blank.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Estatein <alerts@your-domain.example>

# Image storage: use "r2" with the MEDIA_BUCKET binding, or "s3" with the credentials below.
STORAGE_PROVIDER=r2
R2_PUBLIC_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
