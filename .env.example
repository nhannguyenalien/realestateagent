# Pooled Neon connection string; set this as a Cloudflare Pages secret.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/estatein?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@yourdomain.com

# Image storage: use "r2" with the MEDIA_BUCKET binding, or "s3" with the credentials below.
STORAGE_PROVIDER=r2
R2_PUBLIC_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
