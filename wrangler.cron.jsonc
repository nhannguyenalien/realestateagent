{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estatein-daily-property-search",
  "main": "workers/daily-search.ts",
  "compatibility_date": "2025-08-23",
  "triggers": { "crons": ["0 1 * * *"] },
  "vars": {
    "DAILY_SEARCH_URL": "https://your-domain.example/api/cron/daily-property-search/"
  }
}
